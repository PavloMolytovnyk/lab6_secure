# Node.js 24+, без npm залежностей, Docker та окремої БД.
HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
NODE_ENV=development
DEMO_MODE=true
DATA_DIR=.runtime
# Лише локальна демонстрація; у production задайте власний пароль.
ADMIN_EMAIL=admin@lab.test
ADMIN_PASSWORD=Admin2026!StudyOnly

# Реальна пошта: MAIL_TRANSPORT=smtp, DEMO_MODE=false.
MAIL_TRANSPORT=outbox
MAIL_FROM=Security Lab <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USER=
SMTP_PASSWORD=

# Google Cloud Console: Web application, redirect URI нижче.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# http://127.0.0.1:3000/auth/oidc/callback/google

# Автоматично запущений тестовий OIDC-провайдер у demo-режимі.
DEMO_OIDC_PORT=3101
# Його власні навчальні облікові дані:
# oidc.user@provider.test / Provider2026!StudyOnly
